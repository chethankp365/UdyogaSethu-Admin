# ==============================================================================
# UdyogaSethu Admin Environment Configuration Template
# Copy to .env or export these variables in your deployment environment.
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=local

# Supabase PostgreSQL Connection Pooler (Production/Live Profile)
# Host format: aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=udyogasethu_admin_app.mmzbpeqkfomnywuzoqii
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# Supabase Project Endpoints & Auth
SUPABASE_URL=https://mmzbpeqkfomnywuzoqii.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret_or_use_jwks

# Initial Super Admin Bootstrap Credentials
SUPERADMIN_EMAIL=admin@udyogasethu.org
SUPERADMIN_NAME=Platform Administrator
SUPERADMIN_PASSWORD=your_initial_secure_superadmin_password
